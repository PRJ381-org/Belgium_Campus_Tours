# Copy this file to .env and fill in real values. Never commit .env.
# Get the MONGODB_URI connection string from the Discord #programming channel.

# Azure App Service injects PORT at runtime; 4000 is the local default and is
# what the Unreal client (Config/DefaultGame.ini) and the dashboard expect.
PORT=4000
NODE_ENV=development

# Point at a NAMED database, not the default "test".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prj381?retryWrites=true&w=majority

# Comma-separated allowlist of browser origins for the dashboard, e.g.
#   CORS_ORIGIN=https://prj381-backend.azurewebsites.net,http://localhost:4000
# A literal "*" allows any origin. The Unreal client sends no Origin header and
# is unaffected either way.
CORS_ORIGIN=*

# Signs dashboard session tokens. Any long random string; generate your own for
# local dev. The app still BOOTS without this, but every dashboard login fails
# with a 500 and authenticated routes return a misleading 401.
JWT_SECRET=<random-string>

# Microsoft sign-in (Entra ID) - leave blank until Chris shares the App
# Registration details.
MS_CLIENT_ID=
MS_TENANT_ID=
