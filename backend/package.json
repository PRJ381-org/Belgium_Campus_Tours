{
  "name": "prj381-backend",
  "version": "0.2.0",
  "description": "Backend for the VR Campus Open Day (leads + analytics).",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "package": "node scripts/package.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client ci && npm --prefix client run build"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/testEnv.js"
    ],
    "globalSetup": "<rootDir>/tests/helpers/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/helpers/globalTeardown.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongodb": "^7.5.0",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
